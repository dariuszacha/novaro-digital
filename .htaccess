# Apache nustatymai: HTTPS, saugumo antraštės, podėlis (cache)

Options -Indexes
DirectoryIndex index.html

# Visada naudoti HTTPS ir adresą be www
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Git istorija (.git aplankas, .gitignore) niekada neturi būti pasiekiama iš interneto
  RewriteRule (^|/)\.git - [F,L]

  # GTM konteinerio failas ir instrukcijos – tik saugojimui, ne internetui
  RewriteRule ^gtm/ - [F,L]

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # CSP: Google Tag Manager (+ peržiūros režimas / Tag Assistant), Google Analytics 4 ir Meta Pixel. Pridedant naujas GTM žymas, gali tekti papildyti.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://tagmanager.google.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://tagmanager.google.com https://*.googletagmanager.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://ssl.gstatic.com https://www.gstatic.com https://www.facebook.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://tagassistant.google.com https://www.facebook.com https://connect.facebook.net; frame-src https://*.googletagmanager.com https://tagassistant.google.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"

  # HTML tikrinamas kas valandą, paveikslėliai saugomi metus
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Glaudinimas – greitesnis įkėlimas
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest

# Paslėpti tvarkymo failus
<FilesMatch "(\.md|^\.git.*)$">
  Require all denied
</FilesMatch>

# Atsarginė apsauga, jei mod_rewrite neveikia
<IfModule !mod_rewrite.c>
  RedirectMatch 404 (^|/)\.git
</IfModule>
